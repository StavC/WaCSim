[CURVES]
;ID              	X-Value     	Y-Value
;==============================================================================
; PUMP CURVE H1 - Very High-Head Variable Speed Pump
;==============================================================================
; This curve is designed for variable speed operation at LOW speeds:
; - Very high shutoff head (300m) allows operation even at 50% speed
; - At 50% speed: 300 x 0.25 = 75m (still > 63.5m system head!)
; - Smooth, realistic curve shape
;
; At different speeds, the curve scales (head ~ speed^2):
;   Speed 1.5 (150%): Shutoff=675m, can deliver huge flow
;   Speed 1.2 (120%): Shutoff=432m, excellent performance
;   Speed 1.0 (100%): Shutoff=300m, rated operation
;   Speed 0.7 (70%):  Shutoff=147m, still works well
;   Speed 0.5 (50%):  Shutoff=75m, CAN overcome 63.5m system head!
;   Speed 0.4 (40%):  Shutoff=48m, marginal (< 63.5m)
;
; System head requirement: ~63.5m (tank elevation - reservoir head)
; Minimum speed for flow: ~0.46 (300 x 0.46^2 = 63.5m)
;
;------------------------------------------------------------------------------
 H1              	0.0000      	300.000     	; Shutoff head - 300m at zero flow
 H1              	200.0000    	295.000     	; Slight drop
 H1              	400.0000    	285.000     	; Gradual decrease
 H1              	600.0000    	270.000     	; 
 H1              	800.0000    	250.000     	; Mid-range
 H1              	1000.0000   	225.000     	; 
 H1              	1200.0000   	195.000     	; BEP area
 H1              	1400.0000   	160.000     	; 
 H1              	1600.0000   	120.000     	; High flow
 H1              	1800.0000   	80.000      	; Near max flow

;==============================================================================
; EFFICIENCY CURVE E1
;==============================================================================
 E1              	0.0000      	0.          
 E1              	500.00000   	0.55         
 E1              	1000.00000  	0.72         
 E1              	1500.00000  	0.80         ; Peak efficiency
 E1              	2000.00000  	0.75         
 E1              	2500.00000  	0.60         
 E1              	2800.0000   	0.40         

